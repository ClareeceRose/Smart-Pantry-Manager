<?xml version="1.0" encoding="utf-8"?>
<!-- This will be the header that will appear consistently throughout the app -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@color/title_bar_background"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/smart_pantry_logo"
        android:foregroundTint="#FEDE3692"
        android:scaleType="fitStart"
        android:src="@drawable/smart_pantry_logo" />

    <TextView
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fontFamily="@font/calligraffitti"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:text="@string/my_pantry"
        android:textAlignment="textEnd"
        android:textColor="@color/title_text"
        android:textIsSelectable="false"
        android:textSize="34sp"
        android:textStyle="bold" />

</LinearLayout>