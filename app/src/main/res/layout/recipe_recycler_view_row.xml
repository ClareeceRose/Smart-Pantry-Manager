<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/r_recycler_view"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:id="@+id/r_recycler_view_row"
        android:layout_width="350dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        app:cardElevation="10dp"
        android:background="@color/recipe_card_background"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/recipe_card_background"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_gravity="center|center_horizontal"
                android:layout_weight="1"
                android:paddingTop="25dp"
                android:text="@string/recipe_name"
                android:textAlignment="center"
                android:textColor="@color/body_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/divider4"
                android:layout_width="1dp"
                android:layout_height="60dp"
                android:layout_gravity="center|center_horizontal"
                android:background="@color/divider_background" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_gravity="center|center_horizontal|center_vertical"
                android:layout_weight="1"
                android:paddingTop="25dp"
                android:text="@string/recipe_ingredient_count_label"
                android:textAlignment="center"
                android:textColor="@color/body_text"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                app:srcCompat="@drawable/outline_arrow_forward_ios_24" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>